# ConsequenceStudio — copy to apps/studio-desktop/.env for local dev

# Local browser dev: /gateway → Vite proxy → DO hub (see apps/studio-desktop/vite.config.ts)
# Production Tauri / CI: http://165.227.252.58:8001 (set in .gitlab-ci.yml)
VITE_STREAM_GATEWAY_URL=/gateway
VITE_STREAM_HUB_MODE=true
VITE_STUDIO_ENABLE_STREAM=true

VITE_THEORY_ENGINE_AUTH_TOKEN=a2c1d096fbe48357
VITE_STUDIO_CONDUCTOR_AUTH_TOKEN=dev-secret-change-in-production

# Optional overrides (hub mode derives /conductor, /theory, /stream from gateway base)
VITE_STUDIO_CONDUCTOR_HTTP_URL=
