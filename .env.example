# ConsequenceStudio service endpoints (no hardcoded URLs in source)
VITE_CONSEQUENCE_STREAM_WS_URL=ws://localhost:8080/stream
VITE_CMTE_WS_URL=ws://localhost:8081/cmte
VITE_DOCTOR_WS_URL=ws://localhost:8082/doctor
VITE_LEDGER_WS_URL=ws://localhost:8083/ledger
VITE_FLOPPYDISK_HTTP_URL=http://localhost:8084
VITE_FLOPPYDISK_WS_URL=ws://localhost:8084/ws
VITE_THEORY_ENGINE_HTTP_URL=http://127.0.0.1:8741
VITE_THEORY_ENGINE_AUTH_TOKEN=dev-secret-change-in-production

# ConsequencePoet (direct WebSocket — required for Doctor Compose mode)
VITE_STUDIO_POET_WS_URL=ws://localhost:8000
VITE_STUDIO_POET_HTTP_URL=http://localhost:8000
VITE_STUDIO_POET_API_KEY=
# Legacy aliases (still supported)
VITE_POET_WS_URL=ws://localhost:8000
VITE_POET_HTTP_URL=http://localhost:8000
VITE_POET_MAX_RECONNECT_ATTEMPTS=10
VITE_POET_PING_INTERVAL_MS=30000
VITE_POET_PONG_TIMEOUT_MS=5000

# ConsequenceStream (event bus — enable when Stream repo is deployed)
VITE_STUDIO_ENABLE_STREAM=false
VITE_STUDIO_STREAM_URL=ws://localhost:8001/stream

# ConsequenceLedger (cost display — enable when available)
VITE_STUDIO_ENABLE_LEDGER=false
VITE_STUDIO_LEDGER_URL=http://localhost:8002

# ConsequenceTheory (no direct connection — Theory publishes to Stream only)
